# Server-side configuration for the backend. Copy this file to `.env` for
# local development, or set these as real environment variables in whatever
# supplies the process's environment in deployment. Never commit a `.env`
# with real values -- see backend/.gitignore.

# Hosted AI provider (embeddings + generation). Required: the app fails fast
# at startup if this is unset.
PROVIDER_API_KEY=changeme-provider-api-key

# PostgreSQL + pgvector connection string. Falls back to local SQLite
# (sqlite:///./app.db) when unset, so a fresh clone and the test suite run
# without a database server. Point this at Postgres to get the real
# vector(1536) column and SQL-level similarity search.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ragchat

# S3-compatible object storage for original uploaded files. All four are
# required: the app fails fast at startup if any is unset.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=changeme-bucket-name
S3_ACCESS_KEY_ID=changeme-access-key-id
S3_SECRET_ACCESS_KEY=changeme-secret-access-key

# Comma-separated list of origins the browser may call the API from.
# Optional; defaults to the Vite dev server origins when unset.
ALLOWED_ORIGINS=http://localhost:5173
